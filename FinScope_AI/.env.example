# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- Google GenAI (required for AI Financial Explanation) ---
# Create a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Optional local fallback (leave off unless you run Ollama) ---
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- App settings ---
DATABASE_PATH=database/finscope.db
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=10
CURRENCY_SYMBOL=₹
